{
  "name": "aeacus-extension",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "description": "Marks up the parts of a page that read as AI-written, on your own computer",
  "scripts": {
    "build": "node build.mjs",
    "icons": "node tools/icons.mjs",
    "safari": "node tools/safari.mjs",
    "zip": "node tools/pack.mjs",
    "test": "node --test test/*.test.mjs",
    "types": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
    "lint": "eslint .",
    "check": "pnpm types && pnpm lint"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.7",
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.25.12",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "onnxruntime-web": "1.30.0",
    "typescript": "^7.0.2"
  }
}
